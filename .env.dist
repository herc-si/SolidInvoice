AUGIAS_ENV=dev
AUGIAS_DEBUG=1

# MCP session store: file | memory | cache | framework
# - file: on-disk (default, single-node deployments)
# - memory: in-process (dev only; resets on restart)
# - cache: PSR-16 cache pool, configurable via AUGIAS_MCP_SESSION_CACHE_POOL
#   (point to a Redis-backed pool for multi-node)
# - framework: Symfony session.handler (shares the app's session storage)
AUGIAS_MCP_SESSION_STORE=file
AUGIAS_MCP_SESSION_CACHE_POOL=cache.mcp.sessions
AUGIAS_MCP_SESSION_PREFIX=mcp-
AUGIAS_MCP_SESSION_TTL=86400

# MCP OAuth2 token lifetimes (ISO 8601 durations). Longer access tokens mean
# fewer refresh-token round trips for connected AI agents.
AUGIAS_MCP_ACCESS_TOKEN_TTL=P1D
AUGIAS_MCP_REFRESH_TOKEN_TTL=P90D
AUGIAS_MCP_AUTH_CODE_TTL=PT10M

###> symfony/crowdin-translation-provider ###
# Provider-agnostic translation DSN used by translation:push / translation:pull.
# CrowdIn example shown; swap the scheme to use any other Symfony provider.
# AUGIAS_TRANSLATION_DSN=crowdin://PROJECT_ID:API_TOKEN@ORGANIZATION_DOMAIN.default
###< symfony/crowdin-translation-provider ###
