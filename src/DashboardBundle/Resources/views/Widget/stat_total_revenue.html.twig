{% import '@AugiasDashboard/Widget/_stat_value.html.twig' as stat %}

{#
 # Lifetime revenue mixes paid, part-paid and refunded; it is an aggregate, not a
 # payment state, so nothing here is painted in the colour of money received - a
 # new account would otherwise render $0.00 in success green. The icon is `info`
 # for the same reason, one layer down.
 #}
<div class="stat-card">
    <div class="stat-card-content">
        <div class="stat-icon stat-icon--info">
            {{ ux_icon('tabler:trending-up', {width: 24, height: 24}) }}
        </div>
        <div class="stat-info">
            <span class="stat-label">{{ 'dashboard.hero.total_revenue'|trans }}</span>
            {{ stat.statValue(totalRevenue, defaultCurrency, ['total']) }}
        </div>
    </div>
</div>
