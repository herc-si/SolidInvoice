{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:package', {width: 24, height: 24, class: 'me-2'}) }}{{ 'catalog.list.title'|trans }}
{% endblock title %}

{% block heading %}
    <a class="btn btn-primary" href="{{ path('_catalog_add') }}">
        {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
        {{ 'catalog.action.add'|trans }}
    </a>
{% endblock %}

{% block content %}
    <twig:Ui:Card>
        <twig:DataGrid name="catalog_grid" />
    </twig:Ui:Card>
{% endblock %}
