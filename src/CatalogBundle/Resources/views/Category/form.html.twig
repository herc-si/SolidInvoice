{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block content %}
<div class="form-page">
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="form-page-container form-page-container--narrow">
        <div class="form-page-header">
            <div class="form-page-header-content">
                <div class="form-page-icon">
                    {{ ux_icon('tabler:category', {width: 28, height: 28}) }}
                </div>
                <div>
                    {% if category is defined and category.id is not empty %}
                        <h1 class="form-page-title">{{ 'catalog.category.form.edit_title'|trans }}</h1>
                    {% else %}
                        <h1 class="form-page-title">{{ 'catalog.category.form.add_title'|trans }}</h1>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="form-page-sections">
            <section class="form-page-section">
                <div class="section-content">
                    <div class="form-grid">
                        <div class="form-field form-field--full">{{ form_row(form.name) }}</div>
                    </div>
                </div>
            </section>
        </div>

        <div class="card-footer form-actions">
            <a href="{{ path('_catalog_categories_index') }}" class="btn btn-ghost">{{ 'action.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary">
                {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                {{ 'action.save'|trans }}
            </button>
        </div>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
